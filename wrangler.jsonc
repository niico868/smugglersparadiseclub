{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smugglersparadiseclub",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker checks sign-in for these paths; everything else is served straight from /public.
    "run_worker_first": ["/api/*", "/members/*", "/members"]
  },
  "observability": { "enabled": true }
}
